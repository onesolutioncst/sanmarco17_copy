<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="approval_purchase_request_view_form_inherit" model="ir.ui.view">
            <field name="name">approval.purchase.request.view.form.inherit</field>
            <field name="model">approval.request</field>
            <field name="inherit_id" ref="approvals.approval_request_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location']" position="before">
                    <field name="has_operation_type" invisible="1"/>
                    <field name="has_analytic_account" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="approval_type" invisible="1"/>
                    <field name="picking_type_id" invisible="has_operation_type in ['no',False]"
                           required="approval_type == 'create_transfer' or has_operation_type == 'required'"/>
                    <field name="analytic_account_id" invisible="has_analytic_account in ['no',False]"
                           required="approval_type == 'create_transfer'  or has_analytic_account == 'required'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
