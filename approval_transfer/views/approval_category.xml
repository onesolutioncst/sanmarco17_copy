<odoo>
    <data>
        <record id="approval_category_view_form_inherit" model="ir.ui.view">
            <field name="name">approval_category_view_form_inherit</field>
            <field name="model">approval.category</field>
            <field name="inherit_id" ref="approvals.approval_category_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='option_settings']//field[@name='has_location']" position="after">
                    <field name="has_operation_type" string="Operation Type" widget="radio"
                           options="{'horizontal': true}" readonly="approval_type == 'create_transfer'"/>
                    <field name="has_analytic_account" string="Analytic Account" widget="radio"
                           options="{'horizontal': true}" readonly="approval_type == 'create_transfer'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>