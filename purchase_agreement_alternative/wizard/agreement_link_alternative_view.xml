<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_agreement_link_alternative_form" model="ir.ui.view">
            <field name="name">link Alternative</field>
            <field name="model">purchase.agreement.link.alternative</field>
            <field name="arch" type="xml">
                <form string="Link Alternative">
                    <field name="origin_po_id" invisible="1"/>
                    <field name="purchase_requisition_ids" nolabel="1"
                           domain="[('purchase_requisition_id','=',False),('id','!=',origin_po_id)]"/>
                    <footer>
                        <button name="action_link_alternative" string="Link Alternative" data-hotkey="q" type="object"
                                colspan="1" class="btn-primary"/>
                        <button string="Cancel" data-hotkey="x" special="cancel" colspan="1" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
