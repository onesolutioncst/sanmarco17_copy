<odoo>
    <data>
        <record id="product_normal_form_view_product_volume" model="ir.ui.view">
            <field name="name">product.product.form.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <field name="taxes_id" position="after">
                    <field name="account_analytic_account_id" options="{'no_open': True, 'no_create': True}"/>
                    <label for="product_volume" string="Cost Volume" />
                    <div>
                        <field name="product_volume"/>
                        <button name="calc_product_volume_cost" type="object" string="Calc Cost"></button>
                    </div>
                </field>
            </field>
        </record>
    </data>
</odoo>