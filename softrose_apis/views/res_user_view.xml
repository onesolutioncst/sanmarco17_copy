<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_users_form_inherit_api" model="ir.ui.view">
            <field name="name">res.users.form.inherit.api</field>
            <field name="model">res.users</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_title']/group" position="inside">
                    <field name="journal_id" required="0" widget="selection"
                           domain="[('type', '=', 'cash')]"/>
                </xpath>
            </field>
        </record>
        <record id="res_users_view_simple_form_inherit" model="ir.ui.view">
            <field name="name">res.users.simple.form.inherit.inherit.api</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_simple_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='phone_numbers']" position="inside">
                    <field name="journal_id" required="0" widget="selection"
                           domain="[('type', '=', 'cash')]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
