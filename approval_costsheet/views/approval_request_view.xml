<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_request_view_form_costsheet" model="ir.ui.view">
        <field name="name">approval_request_view_form costsheet</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location']" position="before">
                <field name="has_analytic_distribution" invisible="1"/>
                <field name="has_picking_type_id" invisible="1"/>
                <field name="has_location_src_id" invisible="1"/>
                <field name="has_location_dest_id" invisible="1"/>
                <field name="has_vendor_id" invisible="1"/>
                <field name="has_product_id" invisible="1"/>
                <field name="has_product_qty" invisible="1"/>
                <field name="has_analytic_account" invisible="1"/>
                <field name="has_costsheet_order" invisible="1"/>
                <field name="has_multi_costsheet_order" invisible="1"/>
                <field name="from_mrp" invisible="1"/>
            </xpath>
            <group name="request_details" position="after">
                <group name="request_costsheet_details">
                    <field name="vendor_id" invisible="has_vendor_id in ['no',False] or from_mrp"
                           readonly="request_status != 'new'"
                           required="has_vendor_id == 'required'"/>
                    <field name="analytic_account_id" invisible="has_analytic_account in ['no',False] or from_mrp"
                           readonly="request_status != 'new'"
                           required="has_analytic_account == 'required'"/>
                    <field name="mrp_production_id" options="{'no_open': True, 'no_create': True}"
                           invisible="has_costsheet_order in ['no',False] or from_mrp"
                           readonly="request_status != 'new'"
                           required="has_costsheet_order == 'required'"
                           domain="[('sale_costsheet_id.analytic_account_id','=',analytic_account_id)]"/>
                    <label for="mrp_production_ids" invisible="has_multi_costsheet_order in ['no',False] or from_mrp" class="oe_inline"/>
                    <div invisible="has_multi_costsheet_order in ['no',False] or from_mrp" >
                        <field name="mrp_production_ids" widget="many2many_tags"
                               options="{'no_open': True, 'no_create': True}"
                               invisible="has_multi_costsheet_order in ['no',False] or from_mrp"
                               readonly="request_status != 'new'"
                               required="has_multi_costsheet_order == 'required'"
                               domain="[('sale_costsheet_id.analytic_account_id','=',analytic_account_id)]"/>
                        <button name="get_mrp_lines" string="Get lines" type="object"/>
                    </div>
                    <field name="vendor_id" invisible="has_vendor_id in ['no',False] or from_mrp"
                           readonly="request_status != 'new'"
                           required="has_vendor_id == 'required'"/>
                    <field name="suborder_production_id" readonly="1"
                           invisible="approval_type != 'costsheet_suborder'"/>
                    <field name="agreement_production_id" readonly="1"
                           invisible="approval_type != 'costsheet_agreement'"/>
                </group>
            </group>
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_create_costsheet_suborder" type="object"
                        string="Create Costsheet(Suborder)" class="btn-primary"
                        data-hotkey="g"
                        invisible="approval_type != 'costsheet_suborder' or request_status != 'approved' or suborder_production_id"/>
                <button name="action_create_costsheet_multi_suborder" type="object"
                        string="Create Costsheet(Multi Suborder)" class="btn-primary"
                        data-hotkey="g"
                        invisible="approval_type != 'costsheet_multi_suborder' or request_status != 'approved'"/>

                <button name="action_create_costsheet_agreement" type="object"
                        string="Create Costsheet(Agreement)" class="btn-primary"
                        data-hotkey="g"
                        invisible="approval_type != 'costsheet_agreement' or request_status != 'approved' or agreement_production_id"/>

            </xpath>
        </field>
    </record>

    <record id="approval_product_line_view_tree_remainingqty" model="ir.ui.view">
        <field name="name">approval.product.line.view.tree</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_line_view_tree"/>
        <field name="arch" type="xml">
            <field name="quantity" position="attributes">
                <attribute name="sum">Total</attribute>
            </field>
            <field name="quantity" position="after">
                <field name="mrp_demond_qty" readonly="1" force_save="1" sum="total"/>
                <field name="remainig_qty" optional="hide" sum="total"/>
                <field name="mrp_manufacture_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
