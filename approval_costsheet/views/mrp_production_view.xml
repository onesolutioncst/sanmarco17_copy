<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_production_form_view_approval" model="ir.ui.view">
            <field name="name">mrp.production.form.approval</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_approval" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                            invisible="approval_count == 0">
                        <field name="approval_count" widget="statinfo" string="Approvals"/>
                    </button>
                </div>
                <header position="inside">
                    <button name="action_create_approval"
                            invisible="state in ['draft','done','cancel']" type="object"
                            string="Create Approval"/>
                </header>
            </field>
        </record>
    </data>
</odoo>