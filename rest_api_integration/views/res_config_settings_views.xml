<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mobiledata" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail.mobile</field>
        <field name="model">res.config.settings</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="mobile_settings" position="after">
                <div id="mobile_settings_api">
                    <block title="Mobile Information">
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box">
                                <group>
                                    <field name="app_name"/>
                                    <field name="app_version"/>
                                    <field name="app_store_app_link"/>
                                    <field name="google_play_app_link"/>
                                    <!--                                 attrs="{'readonly':[('company_id','!=',1)]}"-->
                                </group>
                            </div>
                        </div>
                    </block>
                </div>
            </div>
        </field>
    </record>
</odoo>
