<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_only_form_view_fleet" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="sale_costsheet.product_template_only_form_view_inherit"/>
            <field name="arch" type="xml">
                <group col="4" name="options" position="inside">
                    <label for="is_fleet" class="oe_inline"/>
                    <div>
                        <field name="is_fleet"/>
                        <field name="fleet_vehicle_id" invisible="is_fleet == False" readonly="1"/>
                    </div>
                </group>
            </field>
        </record>

        <record id="product_normal_form_view_fleet" model="ir.ui.view">
            <field name="name">product.product.form</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="sale_costsheet.product_normal_form_view_inherit"/>
            <field name="arch" type="xml">
                <group col="4" name="options" position="inside">
                    <label for="is_fleet" class="oe_inline"/>
                    <div>
                        <field name="is_fleet"/>
                        <field name="fleet_vehicle_id" invisible="is_fleet == False" readonly="1"/>
                        <button name="open_fleet_product" invisible="is_fleet == False"
                                type="object" string="Create/Update Fleet" class="oe_highlight"
                                context="{'default_product_product_id': active_id, 'default_is_product': True}"/>
                    </div>
                </group>
            </field>
        </record>


    </data>
</odoo>