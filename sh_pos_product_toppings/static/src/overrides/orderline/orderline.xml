<templates id="template" xml:space="preserve">
    <t t-name="Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="after">
            <t t-if="line.is_has_topping">
                <div class='topping-item' t-if='line.Toppings'>
                    <t t-foreach="line.Toppings" t-as="topping" t-key="topping.id">
                        <div class="sh_topping_line_content" style=" display: flex; align-items:baseline;justify-content: space-between;font-size: 84%;font-weight:500;margin-left: 10px;">
                            <div class="sh_toppings_description" style="display: flex; align-items:baseline;">
                                <div style="padding: 0px 5px" class="fa fa-trash" t-att-data-line="topping.id" t-on-click.stop="() => this._clickRemoveLine(topping.id)"></div>
                                <t t-if="topping">
                                    <div class="sh_product_name">
                                        <t t-esc='topping.full_product_name' />
                                    </div>

                                    <em style="margin-left: 5px;">
                                        <t t-esc="topping.quantityStr" />
                                    </em>

                                    <div style="margin-left: 5px;">
                                        <t t-esc="topping.unit" />
                                    </div>
                                    <span style="padding: 0px 5px"> at </span>
                                    <div class="addon-orderline-price">
                                        <t t-esc="env.utils.formatCurrency(topping.price_unit)" />
                                    </div>
                                    <span style="padding: 0px 5px"> / </span>
                                    <t t-esc="topping.unit" />
                                </t>
                            </div>
                            <div style="margin-left: 15px; float: right;">
                                <t t-esc="env.utils.formatCurrency(topping.price_subtotal_incl)" />
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
        <xpath expr="//li[hasclass('orderline')]" position="attributes">
            <attribute name="t-attf-class">{{ line.is_topping  ? 'sh-is-topping' : '123' }}</attribute>
        </xpath>
    </t>

    <t t-name="ShOrderChangeReceipt" t-inherit="point_of_sale.OrderChangeReceipt" t-inherit-mode="extension" >
        <xpath expr="//t[@t-if='changes.cancelled.length > 0']//div[hasclass('multiprint-flex')]" position="replace">
            <div class="multiprint-flex">
                <t t-if="change.is_topping">
                    <span class="product-quantity" style="margin-left: 10% !important;" t-esc="change.quantity"/>
                    <span class="product-name" t-esc="change.name"/> 
                </t>
                <t t-else="">
                    <span class="product-quantity" t-esc="change.quantity"/>
                    <span class="product-name" t-esc="change.name"/>
                </t>
            </div>
        </xpath>
        <xpath expr="//t[@t-if='changes.new.length > 0']//div[hasclass('multiprint-flex')]" position="replace">
            <div class="multiprint-flex"  >
                <t t-if="change.is_topping">
                    <span class="product-quantity" style="margin-left: 10% !important;" t-esc="change.quantity"/>
                    <span class="product-name" t-esc="change.name"/> 
                </t>
                <t t-else="">
                    <span class="product-quantity" t-esc="change.quantity"/>
                    <span class="product-name" t-esc="change.name"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>