<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id='equipment_vehicle_service_types_view_form' model='ir.ui.view'>
        <field name="name">equipment.service.type.form</field>
        <field name="model">equipment.service.type</field>
        <field name="arch" type="xml">
            <form string="Equipment Service Types" editable="bottom">
                <h1>
                    <field name="name"/>
                </h1>
                <group col="4">
                    <field name="category"/>
                    <field name="type"/>
                </group>
                <field name="description" />
            </form>
        </field>
    </record>
    <record id='equipment_vehicle_service_types_view_tree' model='ir.ui.view'>
        <field name="name">equipment.service.type.tree</field>
        <field name="model">equipment.service.type</field>
        <field name="arch" type="xml">
            <tree string="Equipment Service Types" editable="bottom">
                <field name="name"/>
                <field name="category"/>
                <field name="type"/>
            </tree>
        </field>
    </record>

    <record id="equipment_vehicle_service_types_view_search" model="ir.ui.view">
        <field name="model">equipment.service.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category"/>
                <field name="type"/>
                <group expand="1" string="Group By">
                    <filter name="groupby_category" context="{'group_by' : 'category'}"/>
                    <filter name="groupby_category" context="{'group_by' : 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id='equipment_vehicle_service_types_action' model='ir.actions.act_window'>
        <field name="name">Equipment Service Types</field>
        <field name="res_model">equipment.service.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_groupby_category" : True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new type of service
            </p>
            <p>
                Each service can used in contracts, as a standalone service or both.
            </p>
        </field>
    </record>
    <menuitem action="equipment_vehicle_service_types_action" parent="maintenance.menu_maintenance_configuration"
              name="Types"
              id="equipment_vehicle_service_types_action_menu" sequence="1" groups="base.group_no_one"/>
</odoo>