<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee -->
    <record id="view_employee_form_construction" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hr.construction</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="60"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="after">
                <group name="Equipment" string="Equipment" invisible="employee_type != 'equipment'">
                    <label for="is_equipment" class="oe_inline"/>
                    <div>
                        <field name="is_equipment"/>
                        <field name="employee_equipment_id" invisible="is_equipment == False" readonly="1"/>
                        <button name="create_equipment" string="Create/Update Equipment" type="object"
                                class="oe_highlight" invisible="is_equipment == False"/>
                    </div>
                </group>
            </group>
        </field>
    </record>

</odoo>