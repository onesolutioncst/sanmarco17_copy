<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_only_form_view_equipment" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="sale_costsheet.product_template_only_form_view_inherit"/>
            <field name="arch" type="xml">
                <group col="4" name="options" position="inside">
                    <label for="is_equipment" class="oe_inline"/>
                    <div>
                        <field name="is_equipment"/>
                        <field name="maintenance_equipment_id" invisible="is_equipment == False" readonly="1"/>
                    </div>
                </group>
            </field>
        </record>

        <record id="product_normal_form_view_equipment" model="ir.ui.view">
            <field name="name">product.product.form</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="sale_costsheet.product_normal_form_view_inherit"/>
            <field name="arch" type="xml">
                <group col="4" name="options" position="inside">
                    <label for="is_equipment" class="oe_inline"/>
                    <div>
                        <field name="is_equipment"/>
                        <field name="maintenance_equipment_id" invisible="is_equipment == False" readonly="1"/>
                        <button name="create_equipment" string="Create/Update Equipment" type="object"
                                class="oe_highlight" invisible="is_equipment == False"/>
                    </div>
                </group>
            </field>
        </record>


    </data>
</odoo>