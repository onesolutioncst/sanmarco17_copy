<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="maintenance_equipment_view_form_inherit_product" model="ir.ui.view">
            <field name="name">maintenance.equipment.view.form.inherit.hr</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='workcenter_id']" position="after">
                    <label for="is_product" class="oe_inline"/>
                    <div>
                        <field name="is_product"/>
                        <field name="product_product_id" invisible="is_product == False" readonly="1"/>
                        <button name="create_equipment_product" string="Create/Update Product" type="object"
                                class="oe_highlight" invisible="is_product == False"/>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>