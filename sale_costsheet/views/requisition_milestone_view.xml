<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="requisition_milestone_view_tree" model="ir.ui.view">
            <field name="name">requisition.milestone.view.tree</field>
            <field name="model">purchase.requisition.milestone</field>
            <field name="arch" type="xml">
                <tree  sample="1" editable="bottom" create="0" delete="0">
                    <field name="name" readonly="1"/>
                    <field name="purchase_requisition_line_id"  readonly="1"/>
                    <field name="quantity_percentage"  widget="percentage" readonly="1"/>
                    <field name="product_uom_qty" />
                    <field name="deadline" />
                    <field name="is_reached" />
                </tree>
            </field>
        </record>
    </data>
</odoo>