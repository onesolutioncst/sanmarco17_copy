<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_production_form_view_costsheet" model="ir.ui.view">
            <field name="name">mrp.production.form</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">

                <button name="button_mark_done" position="attributes">
                    <attribute name="invisible">is_costsheet</attribute>
                </button>
                <button name="button_mark_done" position="attributes">
                    <attribute name="invisible">is_costsheet</attribute>
                </button>
                <button name="button_mark_done" position="attributes">
                    <attribute name="invisible">is_costsheet</attribute>
                </button>
                <button name="button_mark_done" position="attributes">
                    <attribute name="invisible">is_costsheet</attribute>
                </button>
                <button name="button_scrap" position="attributes">
                    <attribute name="invisible">is_costsheet</attribute>
                </button>
                <field name="product_id" position="after">
                    <field name="is_costsheet" invisible="1"/>
                    <field name="mrp_production_id" invisible="1"/>
                </field>
                <field name="product_id" position="replace">
                    <field name="product_id" domain="[('type', 'in', ['product', 'consu'])]"
                           context="{'default_detailed_type': 'product'}" invisible="is_costsheet == True"
                           readonly="state != 'draft'" default_focus="1" placeholder="Product to build..."/>
                    <field name="product_id" context="{'default_detailed_type': 'product'}" readonly="state != 'draft'"
                           invisible="is_costsheet == False" default_focus="1" placeholder="Product to build..."/>
                </field>
                <label name="bom_label" position="before">
                    <label for="unit_price_standardprice" name="unit_price_standardprice_label"/>
                    <div class="o_row" name="stamdardunitprice_div">
                        <field name="unit_price_standardprice"/>
                        <field name="unit_percentage_standardprice" widget="percentage"/>
                        <field name="standardprice_after_percentage"/>
                        <button name="action_publish_standradprice" type="object" icon="fa-plus"
                                title="Push standrad Price to Sale order" invisible="published_unit_price">
                            <span class="ms-2">Publish Price</span>
                        </button>
                    </div>
                    <label for="unit_price_agreementbefore" name="unit_price_agreementbefore_label"/>
                    <div class="o_row" name="agreementbeforeunitprice_div">
                        <field name="unit_price_agreementbefore"/>
                        <field name="unit_percentage_agreementbefore" widget="percentage"/>
                        <field name="agreementbefore_after_percentage"/>
                        <button name="action_publish_agreementbefore" type="object" icon="fa-plus"
                                title="Push standrad Price to Sale order" invisible="published_unit_price">
                            <span class="ms-2">Publish Price</span>
                        </button>
                    </div>
                    <label for="unit_price_agreementafter" name="unit_price_agreementafter_label"/>
                    <div class="o_row" name="agreementafterunitprice_div">
                        <field name="unit_price_agreementafter"/>
                        <field name="unit_percentage_agreementafter" widget="percentage"/>
                        <field name="agreementafter_after_percentage"/>
                        <button name="action_publish_agreementafter" type="object" icon="fa-plus"
                                title="Push standrad Price to Sale order" invisible="published_unit_price">
                            <span class="ms-2">Publish Price</span>
                        </button>
                    </div>
                    <field name="published_unit_price" invisible="1"/>
                </label>
                <div name="button_box" position="inside">
                    <button name="action_view_suborder" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                            invisible="suborder_count == 0">
                        <field name="suborder_count" widget="statinfo" string="Sub Orders"/>
                    </button>
                    <button name="action_view_requisition" type="object" class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            invisible="requisition_count == 0">
                        <field name="requisition_count" widget="statinfo" string="Agreement"/>
                    </button>
                    <button name="action_view_timesheet" type="object" class="oe_stat_button"
                            icon="fa-calendar"
                            invisible="timesheet_count == 0">
                        <field name="timesheet_count" widget="timesheet_uom" string="Timesheet"/>
                    </button>
                </div>
                <header position="inside">
                    <button name="action_create_suborder"
                            invisible="state in ['draft','done','cancel'] or mrp_production_id" type="object"
                            string="Create Sub Orders"/>
                    <button name="action_create_suborder" invisible="not mrp_production_id" type="object"
                            groups="sale_costsheet.group_create_sub_order_agreement"
                            string="Create Sub Orders"/>
                    <button name="action_create_agreement"
                            invisible="state in ['draft','done','cancel'] or mrp_production_id" type="object"
                            string="Create Agreement"/>
                    <button name="action_create_agreement" invisible="not mrp_production_id" type="object"
                            groups="sale_costsheet.group_create_sub_order_agreement"
                            string="Create Agreement"/>
                </header>
                <xpath expr="//field[@name='move_raw_ids']//tree/field[@name='product_uom_qty']" position="after">
                    <field name="upconsume_qty" optional="hide" sum="total"/>
                    <field name="upconsume_qty_cost" optional="hide" sum="total"/>
                    <field name="total_up" optional="hide" sum="total"/>
                    <field name="total_up_cost" optional="hide" sum="total"/>
                    <field name="planned_price" optional="hide" readonly="parent.state != 'draft'" sum="total"/>
                    <field name="origin_qty" optional="hide" readonly="1" force_save="1" sum="total"/>
                    <field name="origin_qty_cost" optional="hide" sum="total"/>
                    <field name="origin_qty_agreementpricebefore_cost" optional="hide" sum="total"/>
                    <field name="origin_qty_agreementpriceafter_cost" optional="hide" sum="total"/>
                </xpath>

                <xpath expr="//field[@name='move_raw_ids']//tree" position="inside">
                    <field name="recalc_fields" invisible="1"/>
                    <field name="qty_orders" optional="hide" sum="total"/>
                    <field name="qty_orders_cost" optional="hide" sum="total"/>
                    <field name="remaining_qty" optional="hide" sum="total"/>
                    <field name="remaining_qty_cost" optional="hide" sum="total"/>

                    <field name="qty_agreement" optional="hide" sum="total"/>
                    <field name="qty_orders_agreement" optional="hide" sum="total"/>
                    <field name="qty_orders_agreement_cost" optional="hide" sum="total"/>
                    <field name="remaining_qty_agreement" optional="hide" sum="total"/>
                    <field name="remaining_qty_agreement_cost" optional="hide" sum="total"/>
                    <field name="agreement_unit_price_before" optional="hide" sum="total"/>
                    <field name="constru_standard_price" optional="hide" sum="total"/>
                </xpath>
            </field>
        </record>

        <record id="mrp_production_costsheet_action" model="ir.actions.act_window">
            <field name="name">Costsheet Orders</field>
            <field name="res_model">mrp.production</field>
            <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
            <field name="view_id" eval="False"/>
            <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
            <field name="context">{'search_default_todo': True, 'default_company_id':
                allowed_company_ids[0],'default_is_costsheet': True}
            </field>
            <field name="domain">[('is_costsheet', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No costsheet order found. Let's create one.
                </p>
                <p>
                    Use costsheet Orders (CS) to build finished products while consuming components: i.e. 1 Table =
                    4 Table Legs + 1 Table Top
                </p>
            </field>
        </record>

        <menuitem action="mrp_production_costsheet_action"
                  id="menu_mrp_production_costsheet_action"
                  parent="mrp.menu_mrp_manufacturing"
                  sequence="2"/>

        <record id="mrp.mrp_production_action" model="ir.actions.act_window">
            <field name="name">Manufacturing Orders</field>
            <field name="res_model">mrp.production</field>
            <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
            <field name="view_id" eval="False"/>
            <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
            <field name="context">{'search_default_todo': True, 'default_company_id': allowed_company_ids[0]}</field>
            <field name="domain">[('picking_type_id.active', '=', True),('is_costsheet', '=', False)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No manufacturing order found. Let's create one.
                </p>
                <p>
                    Use Manufacturing Orders (MO) to build finished products while consuming components: i.e. 1 Table =
                    4 Table Legs + 1 Table Top
                </p>
            </field>
        </record>
        <record id="view_move_search_manufacturesource" model="ir.ui.view">
            <field name="name">stock.move.search</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="raw_material_production_origin"/>
                </xpath>
            </field>
        </record>
        <record id="view_move_tree_manufacturesource" model="ir.ui.view">
            <field name="name">stock.move.tree.inherit</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="raw_material_production_origin" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>