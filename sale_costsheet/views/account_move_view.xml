<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record model="ir.ui.view" id="view_move_form_costsheet">
            <field name="name">view_move_form.costsheet</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='narration']" position="after">
                   <group name="amounts" string="Amounts" >
                        <field name="retention_ar_amount" widget='monetary'
                               invisible="retention_ar_amount == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="advanced_ar_amount" widget='monetary'
                               invisible="advanced_ar_amount == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="insurance_ar_amount" widget='monetary'
                               invisible="insurance_ar_amount == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="costsheet_inv_total_amount" widget='monetary'
                               invisible="costsheet_inv_total_amount == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_is_discount" widget='monetary'
                               invisible="product_amount_is_discount == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_refundable" widget='monetary'
                               invisible="product_amount_refundable == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_subcontractor" widget='monetary'
                               invisible="product_amount_subcontractor == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_additional" widget='monetary'
                               invisible="product_amount_additional == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_variation_Order" widget='monetary'
                               invisible="product_amount_variation_Order == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_wages" widget='monetary'
                               invisible="product_amount_wages == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_supplier" widget='monetary'
                               invisible="product_amount_supplier == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_customer" widget='monetary'
                               invisible="product_amount_customer == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                        <field name="product_amount_costsheet" widget='monetary'
                               invisible="product_amount_costsheet == 0.0"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>