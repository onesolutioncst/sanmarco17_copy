<odoo>
    <data>
        <record id="action_rfq_crmlead" model="ir.actions.act_window">
            <field name="name">RFQ</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_crm_lead_id': active_id}
            </field>
            <field name="domain">[('crm_lead_id', '=', active_id)]</field>
        </record>
        <record id="action_rfq_bill" model="ir.actions.act_window">
            <field name="name">Bills</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_crm_lead_id': active_id,'default_move_type': 'in_invoice', 'display_account_trust': True}
            </field>
            <field name="domain">[('crm_lead_id', '=', active_id)]</field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="crm_lead_view_form_button" model="ir.ui.view">
            <field name="name">crm_lead_view_form_inheirt</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="%(sale_costsheet.action_rfq_crmlead)d" string="New RFQ"
                            type="action" class="oe_highlight" context="{'default_crm_lead_id': active_id}"
                            data-hotkey="w" >
                        <field name="rfq_count" widget="statinfo" string="RFQ"/>
                    </button>
                    <button name="%(sale_costsheet.action_rfq_bill)d" string="Bills"
                            type="action" class="oe_highlight" context="{'default_crm_lead_id': active_id}"
                            data-hotkey="w" >
                        <field name="account_move_count" widget="statinfo" string="Bills"/>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>