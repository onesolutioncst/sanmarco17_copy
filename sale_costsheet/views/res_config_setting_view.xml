<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sale</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="10"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <block name="sale_shipping_setting_container" position="inside">
                    <block title="Construction Products" name="sale_construction_product">
                        <setting id="sales_sale_construction_product_retention_ap"
                                 title="This default value is applied to Rentention Product."
                                 help="Rentention Account Payable Product">
                            <field name="retention_ap_default_product_id" class="o_light_label" options='{"no_open": True, "no_create": True}'/>
                        </setting>
                        <setting id="sales_sale_construction_product_retention_ar"
                                 title="This default value is applied to Rentention Product."
                                 help="Rentention Account Receivable Product">
                            <field name="retention_ar_default_product_id" class="o_light_label" options='{"no_open": True, "no_create": True}'/>
                        </setting>
                        <setting id="sales_sale_construction_product_advanced_ap"
                                 title="This default value is applied to Advanced Product."
                                 help="Advanced Account Payable Product">
                            <field name="advanced_ap_default_product_id" class="o_light_label" options='{"no_open": True, "no_create": True}'/>
                        </setting>
                        <setting id="sales_sale_construction_product_advanced_ar"
                                 title="This default value is applied to Advanced Product."
                                 help="Advanced Account Receivable Product">
                            <field name="advanced_ar_default_product_id" class="o_light_label" options='{"no_open": True, "no_create": True}'/>
                        </setting>
                        <setting id="sales_sale_construction_product_insurance_ap"
                                 title="This default value is applied to Insurance Product."
                                 help="Insurance Account Payable Product">
                            <field name="insurance_ap_default_product_id" options='{"no_open": True, "no_create": True}' class="o_light_label"/>
                        </setting>

                        <setting id="sales_sale_construction_product_insurance_ar"
                                 title="This default value is applied to Insurance Product."
                                 help="Insurance Account Receivable Product">
                            <field name="insurance_ar_default_product_id" options='{"no_open": True, "no_create": True}' class="o_light_label"/>
                        </setting>
                    </block>
                </block>
            </field>
        </record>
    </data>
</odoo>