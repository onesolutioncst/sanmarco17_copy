<odoo>
    <data>
        <record id="view_order_form_costsheet" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="payment_term_id" position="after">
                    <label for="is_costsheet" class="oe_inline"/>
                    <div>
                        <field name="is_costsheet"/>
                        <button name="create_sale_costsheet" string="Create/Update Costsheet" type="object"
                                class="oe_highlight" invisible="is_costsheet == False"/>
                    </div>
                    <label for="is_retention_ar" invisible="state == 'draft'" class="oe_inline"/>
                    <div invisible="state == 'draft'">
                        <field name="is_retention_ar"/>
                        <label for="rentention_dis_type" string="" class="oe_inline"
                               invisible="is_retention_ar == False"/>
                        <div class="oe_inline" invisible="is_retention_ar == False">
                            <field name="rentention_dis_type" invisible="is_retention_ar == False"
                                   required="is_retention_ar == True" class="oe_inline"/>
                            <field name="rentention_amount" invisible="rentention_dis_type == 'percentage'"
                                   required="is_retention_ar == True" class="oe_inline"/>
                            <field name="rentention_amount" invisible="rentention_dis_type == 'fixed'"
                                   widget="percentage" required="is_retention_ar == True" class="oe_inline"/>
                        </div>
                    </div>

                    <label for="is_advanced_ar" invisible="state == 'draft'" class="oe_inline"/>
                    <div invisible="state == 'draft'">
                        <field name="is_advanced_ar"/>
                        <label for="advanced_dis_type" string="" class="oe_inline" invisible="is_advanced_ar == False"/>
                        <div class="oe_inline" invisible="is_advanced_ar == False">
                            <field name="advanced_dis_type" required="is_advanced_ar == True" class="oe_inline"/>
                            <field name="advanced_amount" invisible="advanced_dis_type == 'percentage'"
                                   required="is_advanced_ar == True" class="oe_inline"/>
                            <field name="advanced_amount" invisible="advanced_dis_type == 'fixed'" widget="percentage"
                                   required="is_advanced_ar == True" class="oe_inline"/>
                        </div>
                    </div>

                    <label for="is_insurance_ar" invisible="state == 'draft'" class="oe_inline"/>
                    <div invisible="state == 'draft'">
                        <field name="is_insurance_ar"/>
                        <label for="insurance_dis_type" string="" class="oe_inline"
                               invisible="is_insurance_ar == False"/>
                        <div class="oe_inline" invisible="is_insurance_ar == False">
                            <field name="insurance_dis_type" required="is_insurance_ar == True" class="oe_inline"/>
                            <field name="insurance_amount" invisible="insurance_dis_type == 'percentage'"
                                   required="is_insurance_ar == True" class="oe_inline"/>
                            <field name="insurance_amount" invisible="insurance_dis_type == 'fixed'" widget="percentage"
                                   required="is_insurance_ar == True" class="oe_inline"/>
                        </div>
                    </div>
                </field>
                <div name="button_box" position="inside">
                    <button name="action_view_costsheet" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                            invisible="costsheet_count == 0">
                        <field name="costsheet_count" widget="statinfo" string="Costsheet"/>
                    </button>
                </div>
                <xpath expr="//field[@name='note']" position="after">
                    <group>
                        <group>
                            <field name="retention_ar_amount" widget='monetary' options="{'currency_field': 'currency_id'}"
                                   readonly="True"/>
                            <field name="advanced_ar_amount" widget='monetary' options="{'currency_field': 'currency_id'}"
                                   readonly="True"/>
                            <field name="insurance_ar_amount" widget='monetary' options="{'currency_field': 'currency_id'}"
                                   readonly="True"/>
                            <field name="costsheet_inv_total_amount" widget='monetary' options="{'currency_field': 'currency_id'}"
                                   readonly="True"/>
                        </group>

                    </group>
                </xpath>

            </field>
        </record>

    </data>
</odoo>